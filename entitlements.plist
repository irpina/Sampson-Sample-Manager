<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required for Python interpreter to function with hardened runtime -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    
    <!-- Allow dylib loading (required for Python extension modules) -->
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    
    <!-- Disable library validation to allow Python's dynamically loaded modules -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    
    <!-- File access - allow user-selected files (for file browser dialogs) -->
    <key>com.apple.security.files.user-selected.read-write</key>
    <true/>
    
    <!-- Audio access - if needed for playback features -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
</dict>
</plist>
